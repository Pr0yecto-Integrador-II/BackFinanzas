DATABASE_URL=postgresql+asyncpg://finanzas:finanzas@localhost:5433/finanzas
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:4200
# Azure AI Speech (MVP 2). Nunca subas la clave real al repositorio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TOKEN_TIMEOUT_SECONDS=5
# Azure AI Vision (MVP 3). Nunca subas la clave real al repositorio.
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=
AZURE_VISION_TIMEOUT_SECONDS=10
# read,tags funciona en todas las regiones; agrega ,caption solo si tu región lo admite.
AZURE_VISION_FEATURES=read,tags
VISION_MAX_IMAGE_BYTES=4194304
VISION_REQUESTS_PER_HOUR=30
