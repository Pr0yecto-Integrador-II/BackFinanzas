{
  "components": {
    "schemas": {
      "ChangeIn": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "entity": {
            "enum": [
              "category",
              "recurring_rule",
              "transaction",
              "budget"
            ],
            "title": "Entity",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "op": {
            "enum": [
              "upsert",
              "delete"
            ],
            "title": "Op",
            "type": "string"
          }
        },
        "required": [
          "entity",
          "op",
          "id"
        ],
        "title": "ChangeIn",
        "type": "object"
      },
      "ForgotPasswordIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 300,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ForgotPasswordIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 300,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1000,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "MessageOut": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageOut",
        "type": "object"
      },
      "PullChangeOut": {
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "deleted": {
            "title": "Deleted",
            "type": "boolean"
          },
          "entity": {
            "title": "Entity",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "entity",
          "id",
          "version",
          "data",
          "deleted"
        ],
        "title": "PullChangeOut",
        "type": "object"
      },
      "PullOut": {
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/components/schemas/PullChangeOut"
            },
            "title": "Changes",
            "type": "array"
          },
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "next_since": {
            "title": "Next Since",
            "type": "integer"
          }
        },
        "required": [
          "changes",
          "next_since",
          "has_more"
        ],
        "title": "PullOut",
        "type": "object"
      },
      "PushIn": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/components/schemas/ChangeIn"
            },
            "maxItems": 500,
            "title": "Changes",
            "type": "array"
          }
        },
        "required": [
          "changes"
        ],
        "title": "PushIn",
        "type": "object"
      },
      "PushOut": {
        "properties": {
          "applied": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Applied",
            "type": "array"
          },
          "rejected": {
            "items": {
              "$ref": "#/components/schemas/RejectedOut"
            },
            "title": "Rejected",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "applied",
          "rejected",
          "version"
        ],
        "title": "PushOut",
        "type": "object"
      },
      "RegisterIn": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "default": "COP",
            "maxLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "email": {
            "maxLength": 300,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1000,
            "title": "Password",
            "type": "string"
          },
          "password_confirmation": {
            "maxLength": 1000,
            "title": "Password Confirmation",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "password_confirmation"
        ],
        "title": "RegisterIn",
        "type": "object"
      },
      "RejectedOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "message"
        ],
        "title": "RejectedOut",
        "type": "object"
      },
      "ResetPasswordIn": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 1000,
            "title": "Password",
            "type": "string"
          },
          "password_confirmation": {
            "maxLength": 1000,
            "title": "Password Confirmation",
            "type": "string"
          },
          "token": {
            "maxLength": 200,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password",
          "password_confirmation"
        ],
        "title": "ResetPasswordIn",
        "type": "object"
      },
      "SessionOut": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "access_token",
          "user"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "currency"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "BackFinanzas",
    "version": "0.1.0"
  },
